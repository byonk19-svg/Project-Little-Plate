# Supabase prints these values after `pnpm supabase:start`.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
# Optional private-dogfood gate. When present, only these normalized email
# addresses may use the app; an explicitly empty value denies everyone.
# PRIVATE_PILOT_ALLOWED_EMAILS=owner@example.com,tester@example.com
# Optional developer-only shortcut shown after a successful sign-in request.
# NEXT_PUBLIC_LOCAL_MAIL_URL=http://127.0.0.1:56324
