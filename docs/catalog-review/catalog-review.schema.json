{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catalog review intake",
  "type": "object",
  "required": ["inventory_snapshot", "records"],
  "properties": {
    "inventory_snapshot": { "type": "string" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "repository_path",
          "record_id",
          "record_type",
          "classification",
          "existing_value",
          "existing_provenance",
          "missing_data",
          "reviews"
        ],
        "properties": {
          "repository_path": {
            "type": "string",
            "pattern": "^(?![A-Za-z]:)[^\\\\]+"
          },
          "record_id": { "type": "string" },
          "record_type": {
            "type": "string",
            "enum": [
              "food",
              "preparation",
              "revision",
              "source",
              "tag",
              "storage_rule",
              "visual",
              "other"
            ]
          },
          "classification": {
            "type": "string",
            "enum": ["production", "fixture", "seed", "demo", "test"]
          },
          "existing_value": {},
          "existing_provenance": {},
          "missing_data": { "type": "array", "items": { "type": "string" } },
          "reviews": { "type": "array", "items": { "$ref": "#/$defs/review" } }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "review": {
      "type": "object",
      "required": [
        "area",
        "reviewer_role",
        "reviewer_authority_reference",
        "decision",
        "specific_concern",
        "missing_information_or_provenance",
        "evidence_sources",
        "proposed_replacement_or_addition",
        "notes",
        "approval_reference_id",
        "review_date",
        "follow_up_required"
      ],
      "properties": {
        "area": {
          "type": "string",
          "enum": [
            "feeding_safety_developmental",
            "allergy_restriction",
            "nutrition_age_stage",
            "taxonomy_labeling",
            "storage_handling",
            "visual_accessibility_rights"
          ]
        },
        "reviewer_role": { "type": "string" },
        "reviewer_authority_reference": { "type": "string" },
        "storage_context": {
          "type": "object",
          "properties": {
            "existing_storage_guidance": {},
            "refrigeration_freezing": {},
            "duration_claim": {},
            "reheating_serving_implication": {}
          },
          "additionalProperties": false
        },
        "visual_context": {
          "type": "object",
          "properties": {
            "visual_reference": {},
            "rights_license_evidence": {},
            "alt_text": {}
          },
          "additionalProperties": false
        },
        "decision": {
          "type": "string",
          "enum": [
            "Accept",
            "Accept with clarification",
            "Revise",
            "Block",
            "Not applicable",
            "Insufficient evidence"
          ]
        },
        "specific_concern": { "type": "string" },
        "missing_information_or_provenance": { "type": "string" },
        "evidence_sources": { "type": "array", "items": { "type": "string" } },
        "proposed_replacement_or_addition": {},
        "notes": { "type": "string" },
        "approval_reference_id": { "type": ["string", "null"] },
        "review_date": { "type": ["string", "null"], "format": "date" },
        "follow_up_required": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "area": { "const": "storage_handling" } },
            "required": ["area"]
          },
          "then": { "required": ["storage_context"] }
        },
        {
          "if": {
            "properties": {
              "area": { "const": "visual_accessibility_rights" }
            },
            "required": ["area"]
          },
          "then": { "required": ["visual_context"] }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
