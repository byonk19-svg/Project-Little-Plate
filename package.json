{
  "name": "project-little-plate",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "node scripts/ensure-local-env.mjs && next dev",
    "build": "next build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:legacy": "vitest run --config vitest.legacy.config.ts",
    "test:integration": "pnpm supabase:reset && vitest run --config vitest.integration.config.ts",
    "test:integration:legacy": "pnpm supabase:reset && vitest run --config vitest.integration.legacy.config.ts",
    "test:watch": "vitest",
    "test:e2e": "pnpm supabase:reset && playwright test",
    "test:catalog-sources": "node --test scripts/check-catalog-sources.test.mjs",
    "catalog:check-sources": "node scripts/check-catalog-sources.mjs",
    "operations:rehearse-restore": "node scripts/rehearse-local-backup-restore.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm verify:database && pnpm test:integration && pnpm test:e2e && node scripts/check-whitespace.mjs",
    "verify:legacy": "pnpm test:legacy && pnpm test:catalog-sources && pnpm test:integration:legacy",
    "verify:database": "supabase start && supabase db reset --local && supabase stop && supabase start",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset --local"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.9",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "20.19.43",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "jsdom": "26.1.0",
    "prettier": "3.9.6",
    "supabase": "2.109.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.0.18"
  }
}
